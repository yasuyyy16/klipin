# Konfigurasi Klipin (04-arsitektur.md §8.2).
# Salin ke `.env` lalu isi yang perlu. `.env` tidak boleh di-commit.
# Semua variabel opsional; baris kosong berarti memakai nilai default.

# Folder kerja (database, video, render, log). Default: ~/Klipin
KLIPIN_HOME=

# Port API lokal. Default: 8765
KLIPIN_PORT=8765

# Alamat loopback yang di-bind, dipisah koma. Default: 127.0.0.1,::1
# Jangan diubah ke 0.0.0.0 (BR-012); alamat non-loopback ditolak saat start.
KLIPIN_HOST=127.0.0.1,::1

# Path ffmpeg.exe jika FFmpeg tidak ada di PATH. Default: kosong (pakai PATH)
KLIPIN_FFMPEG_PATH=

# Jumlah Job berat yang boleh jalan bersamaan. Default: 1 (bisa diatur juga di Pengaturan)
KLIPIN_MAX_HEAVY_JOBS=1

# Cadangan penyedia transkripsi bila Pengaturan kosong (Pengaturan selalu menang): deepgram | assemblyai. Default: deepgram
KLIPIN_TRANSCRIBER=deepgram

# Cadangan penyedia LLM bila Pengaturan kosong (Pengaturan selalu menang): anthropic. Default: anthropic
KLIPIN_LLM_PROVIDER=anthropic

# API key transkripsi & LLM. Isi HANYA jika keyring OS tidak tersedia;
# normalnya diisi lewat halaman Pengaturan (tersimpan di keyring).
TRANSCRIBER_API_KEY=
LLM_API_KEY=

# Kredensial aplikasi developer untuk Mode Unggah `auto` (v1.1). Kosongkan jika tidak dipakai.
# YouTube: OAuth client tipe Desktop dari Google Cloud Console
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# TikTok: aplikasi TikTok for Developers (Login Kit + Content Posting API, Direct Post)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Instagram & Facebook: aplikasi Meta (Facebook Login + Instagram/Pages API)
META_APP_ID=
META_APP_SECRET=

# Basis redirect URI OAuth: {base}/oauth/callback/{platform}. Default: http://localhost:8765
KLIPIN_OAUTH_REDIRECT_BASE=http://localhost:8765

# Level log: DEBUG | INFO | WARNING | ERROR. Default: INFO
KLIPIN_LOG_LEVEL=INFO

# real = penyedia asli; fake = penyedia & media palsu (fixture, tanpa jaringan) untuk tes & pengembangan tanpa biaya. Default: real
KLIPIN_PROVIDERS=real
